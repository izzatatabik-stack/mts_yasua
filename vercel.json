{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app/:slug*",
      "destination": "/app.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpg|png|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
